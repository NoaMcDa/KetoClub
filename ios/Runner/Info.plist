<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>KetoClub</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>KetoClub</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<!-- Device position for nearby search (architecture.md §6.5, issue
		     #37): read once, used only to list nearby restaurants and sent
		     only to the restaurant platform as a search parameter, never
		     stored.

		     English is inline here as the default, so the prompt reads in
		     English on any device whose pbxproj has not yet been updated
		     to include ios/Runner/{en,he}.lproj/InfoPlist.strings (issue
		     #169). Once those files are added to the Runner target in
		     Xcode (Editor → Add File to Project…), iOS reads the localised
		     string from the matching `.lproj/InfoPlist.strings` and this
		     inline value is only the last-resort default. See
		     docs/RUNNING_IOS.md's "iOS Hebrew permission string" note. -->
		<string>KetoClub uses your location once to list nearby restaurants. It is sent only to the restaurant platform as a search parameter and is never stored.</string>
		<key>NSCameraUsageDescription</key>
		<!-- The Scan tab's "Take a photo" (architecture.md D15, issue #82):
		     the camera is opened only when the user taps it, and the photo
		     is read once and kept in memory only. English inline as the
		     default; he.lproj/InfoPlist.strings carries the Hebrew, see
		     the location key above. -->
		<string>KetoClub uses the camera to photograph a menu page. The photo is sent to Google's Gemini API to read the dishes and is not saved on this device.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<!-- The Scan tab's "Choose photos" (issue #82): only the pictures
		     the user picks are read. -->
		<string>KetoClub reads the menu photos you choose. They are sent to Google's Gemini API to read the dishes and are not saved on this device.</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<!-- Lets url_launcher open a venue's own page on Wolt or 10bis
			     (issue #53) in the default browser or that platform's app. -->
			<string>https</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
