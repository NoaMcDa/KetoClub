# KetoClub backend — environment variables.
# Copy to .env and fill in values. All variables have safe defaults except
# GEMINI_API_KEY and ADMIN_TOKEN, which must be set for the relevant
# routes to work.

# The server's Gemini API key.  Unset → /v1/chat answers notConfigured.
# Sent upstream only as the x-goog-api-key header, never in a URL.
GEMINI_API_KEY=

# Model id requested from generateContent. gemini-2.5-flash was retired for
# new users in September 2026 (Google's API answers 404 recommending
# gemini-3.8-flash); gemini-3.5-flash is a stable pick that supports
# generationConfig.thinkingConfig and responseSchema. gemini-flash-latest and
# gemini-3.8-flash currently return 503 UNAVAILABLE for structured output;
# gemini-flash-lite-latest is cheaper but rejects thinkingConfig with 400
# (see issue #179 for the successor picking).
GEMINI_MODEL=gemini-3.5-flash

# Upstream Gemini host.  Never taken from a request.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# generationConfig.maxOutputTokens.  A reply that hits it (finishReason
# MAX_TOKENS) is answered badResponse, so it must exceed what a 100+ dish
# Hebrew menu's verdicts take (#188).  65536 is the ceiling of the Flash family this backend targets.
GEMINI_MAX_OUTPUT_TOKENS=65536

# generationConfig.thinkingConfig.thinkingBudget.  Thinking tokens count
# against the output budget, and this is a classification task, so 0.
GEMINI_THINKING_BUDGET=0

# Log an upstream error reply's error.message and details[].reason entries
# (key redacted) on top of the always-on error_status line.  Off by default:
# the message can quote the request.  Turn on when diagnosing why Gemini
# refuses a menu; the request/reply shape lines (sizes, token counts,
# finish reason, latency) are logged regardless.
GEMINI_LOG_UPSTREAM_ERRORS=false

# Bounds on POST /v1/chat's optional images (menu pages, D15, #170): at most
# this many parts per request, each at most this many bytes once decoded
# (3 MiB).  Over either → 422 before any upstream call.  Images are forwarded
# to Gemini as inline_data parts and never cached, stored or logged.
VISION_MAX_IMAGES=6
VISION_MAX_IMAGE_BYTES=3145728

# Wolt host for the by-name venue search (POST /v1/pages/search, #123).
# The menu proxy left this host in #168.  Never taken from a request.
WOLT_BASE_URL=https://restaurant-api.wolt.com

# Upstream 10bis host for the proxy route (#122).  Never taken from a request.
TENBIS_BASE_URL=https://www.10bis.co.il

# Wolt's consumer host: the menu proxy's consumer-assortment endpoint (#168)
# and the "venues near a point" discovery page (#123).  Never taken from a
# request.
WOLT_CONSUMER_BASE_URL=https://consumer-api.wolt.com

# Wolt's own web-client version string, sent as both client-version and
# clientversionnumber on menu and discovery requests.  Bump when Wolt's web client
# moves on.
WOLT_CLIENT_VERSION=1.16.125

# SQLAlchemy database URL.  Postgres is an env-var swap later; Alembic lands
# with it.  SQLite used for local dev and CI.
DATABASE_URL=sqlite:///./ketoclub.db

# CORS: allow_origin_regex.  Flutter dev server picks a random port, so we
# allow any localhost / 127.0.0.1 port.  Tighten this for a public host.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Bearer token for /v1/admin/* routes.  Unset → 503.
ADMIN_TOKEN=

# Raw Wolt body cache TTL in seconds (proxy route, #95).
MENU_CACHE_TTL_SECONDS=3600

# Shared LLM completion cache TTL in seconds (#103).
# Equal to the Flutter app's menuCacheTtl so a cached analysis stays valid as
# long as the cached menu.
CHAT_CACHE_TTL_SECONDS=86400

# Per-install-ID rate limits on /v1/chat and write endpoints (#101).
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40

# Discovery response cache TTL in seconds (#123).
DISCOVERY_CACHE_TTL_SECONDS=300

# Per-install-ID, minute-window-only rate limit on the two discovery routes
# (#123).  No daily cap.
DISCOVERY_RATE_LIMIT_PER_MINUTE=20

# --- Website menus (D19, #181) ------------------------------------------------
# POST /v1/website/fetch. The User-Agent names the fetcher (robots.txt token
# ketoclubbot) and a contact URL.
WEBSITE_USER_AGENT="KetoClubBot/1.0 (+https://github.com/NoaMcDa/KetoClub; menu reader)"
# Size caps in bytes; the PDF cap matches VISION_MAX_IMAGE_BYTES.
WEBSITE_MAX_HTML_BYTES=2097152
WEBSITE_MAX_PDF_BYTES=3145728
# robots.txt is read up to this many bytes and cached per host this long.
WEBSITE_MAX_ROBOTS_BYTES=524288
WEBSITE_ROBOTS_TTL_SECONDS=3600
# Fetches per site across every install, and per install id, in any 60 s.
WEBSITE_HOST_RATE_LIMIT_PER_MINUTE=6
WEBSITE_RATE_LIMIT_PER_MINUTE=10
