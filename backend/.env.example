# KetoClub backend configuration. Copy to .env and edit; every value below is
# the built-in default, so the service starts with no .env at all.

# The server's OpenRouter key. Empty means POST /v1/chat answers
# notConfigured and the app falls back to the user's own key, then to rules.
# Not used until issue #100 lands.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# Upstream host for the menu proxy. Never read from a request.
WOLT_BASE_URL=https://restaurant-api.wolt.com

DATABASE_URL=sqlite:///./ketoclub.db

# Origins allowed to call this service. The default admits any localhost port,
# because Flutter's development server picks one at random.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Required by /v1/admin/*. Empty means those routes are unavailable.
# Not used until issue #107 lands.
ADMIN_TOKEN=

MENU_CACHE_TTL_SECONDS=3600
CHAT_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40
